import { ScrollView } from "std-widgets.slint";
export struct AlbumDetails {
    album: string,
    date: string,
    location: string,
    barcode: string,
    comment: string,
    thumbnail: image,
    id: string,
}

global Sizes {
    out property <length> tile-width: 480px;
    out property <length> thumbnail: 125px;
    out property <length> spacing: 10px;
    out property <length> tile-height: thumbnail + (2 * spacing);
}

component AlbumTile {
    in property <brush> bkg <=> box.background;
    in property <AlbumDetails> details;
    property thumb <=> details.thumbnail;
    callback clicked <=> touch.clicked;
    box := Rectangle {
        accessible-role: AccessibleRole.list-item;
        accessible-description: details.album + " " + details.comment + ". Released on " + details.date + " in " + details.location + ", barcode: " + details.barcode;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 0px;
        drop-shadow-color: darkgray;
        drop-shadow-blur: Sizes.spacing * 0.8;
        border-radius: self.drop-shadow-blur / 2;
        min-width: Sizes.tile-width;
        touch := TouchArea { }

        HorizontalLayout {
            alignment: start;
            padding: Sizes.spacing;
            thumbnail := Image {
                horizontal-alignment: left;
                width: Sizes.thumbnail;
                height: Sizes.thumbnail;
                source: thumb;
            }

            info := VerticalLayout {
                spacing: Sizes.spacing;
                padding-top: Sizes.spacing / 2;
                padding-left: Sizes.spacing * 2.5;
                alignment: start;
                name := Text {
                    text: details.album;
                    font-weight: FontWeight.semi-bold;
                    font-size: 1.5rem;
                }

                comment := Text {
                    text: details.comment;
                }

                where_when := HorizontalLayout {
                    Text {
                        text: "Released: " + details.date;
                    }

                    Text {
                        text: details.location;
                    }
                }

                barcode := Text {
                    text: "Barcode: " + details.barcode;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "rip";
    property <int> tiles: root.albums.length;
    property <int> prefered-cols: 2;
    property <int> prefered-rows: (tiles + 1) / prefered-cols; // rounds down
    preferred-width: (prefered-cols * Sizes.tile-width) + (2 * (prefered-cols + 1) * Sizes.spacing);
    preferred-height: (prefered-rows * Sizes.tile-height) + (2 * (prefered-rows + 1) * Sizes.spacing);
    in-out property <[AlbumDetails]> albums: [
        {
            album: "Oasis: Definitely Maybe",
            date: "1994-08-30",
            location: "GB",
            barcode: "5017556601693",
            comment: "(Plant MFG pressing)",
            thumbnail: @image-url("../../../tests/assets/definitely_maybe/thumbnail.jpeg"),
        },
        {
            album: "Oasis: Definitely Maybe",
            date: "1994-08-30",
            location: "GB",
            barcode: "5017556601693",
            comment: "(Plant MFG pressing)",
            thumbnail: @image-url("../../../tests/assets/definitely_maybe/thumbnail.jpeg"),
        },
        {
            album: "Oasis: Definitely Maybe",
            date: "1994-08-30",
            location: "GB",
            barcode: "5017556601693",
            comment: "(Plant MFG pressing)",
            thumbnail: @image-url("../../../tests/assets/definitely_maybe/thumbnail.jpeg"),
        }
    ];
    callback select_release(release: AlbumDetails);
    ScrollView {
        min-width: Sizes.tile-width + (2 * Sizes.spacing);
        min-height: Sizes.tile-height + (2 * Sizes.spacing);
        if root.albums.length > 1: album_selector := FlexboxLayout {
            out property <string> selected_release;
            padding: Sizes.spacing * 2;
            spacing: Sizes.spacing * 2;
            cross-axis-line-alignment: start;
            for album[index] in root.albums: AlbumTile {
                bkg: root.background;
                details: album;
                clicked => { root.select_release(album) }
            }
        }
        if root.albums.length == 1: AlbumTile {
            bkg: root.background;
            details: albums[0];
        }
    }
}
